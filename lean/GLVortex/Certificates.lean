def denominatorU (x : ℝ) : ℝ := (55000) * x ^ 0 + (6128) * x ^ 1 + (288) * x ^ 2 + (16) * x ^ 3 + (1) * x ^ 4

theorem denominatorU_pos (x : ℝ) (hlo : 0 ≤ x) : 0 < denominatorU x := by
  have hu : 0 ≤ (x - 0) := by linarith
  have hv : (0 : ℝ) ≤ 1 := by norm_num
  have huv : 0 < (x - 0) + 1 := by linarith
  have hp := heval_pos [55000, 6128, 288, 16, 1] (by simp) (by norm_num) (x - 0) 1 hu hv huv
  have hid : denominatorU x = heval [55000, 6128, 288, 16, 1] (x - 0) 1 := by
    simp only [denominatorU, heval, List.length_cons, List.length_nil]
    ring
  rw [hid]
  exact hp

