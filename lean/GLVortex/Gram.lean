import Mathlib.Tactic

set_option maxRecDepth 10000
set_option maxHeartbeats 0

namespace GLVortex

def gram2_00 : ℚ := (- / )
theorem gram2_negative : gram2_00 < 0 := by norm_num [gram2_00]

def gram3_00 : ℚ := (- / )
theorem gram3_negative : gram3_00 < 0 := by norm_num [gram3_00]

def gram4_00 : ℚ := (- / )
def gram4_01 : ℚ := (- / )
def gram4_11 : ℚ := (- / )
theorem gram4_negative : gram4_00 < 0 := by norm_num [gram4_00]

theorem gram4_det_positive : 0 < gram4_00 * gram4_11 - gram4_01 ^ 2 := by
  norm_num [gram4_00, gram4_11, gram4_01]

def gram5_00 : ℚ := (- / )
theorem gram5_negative : gram5_00 < 0 := by norm_num [gram5_00]

def gram6_00 : ℚ := (- / )
theorem gram6_negative : gram6_00 < 0 := by norm_num [gram6_00]

end GLVortex
